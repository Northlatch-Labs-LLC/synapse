# Private npm registry (Verdaccio) at the registry subdomain — OPTIONAL
# fragment. Rendered by render-edge-config.sh ONLY when SYNAPSE_REGISTRY_DOMAIN
# is set. Deployments without a registry subdomain (single-domain TLS,
# selfsigned, http) expose the registry on a dedicated plain-HTTP host port
# instead (verdaccio's own port published via SYNAPSE_REGISTRY_BIND /
# SYNAPSE_REGISTRY_PORT in docker-compose.yml) — npm handles http registries
# fine, and serving verdaccio directly keeps the port in the Host header so its
# generated dist.tarball URLs stay correct (an nginx proxy_set_header Host $host
# would silently drop a non-default port).
#
# TLS is terminated here (same SAN cert) and proxied to the verdaccio container
# on the internal docker network. The verdaccio service lives behind the
# `registry` compose profile, so it may be absent when nginx starts — we
# resolve its name lazily via docker's embedded DNS (127.0.0.11) using a
# variable upstream, so nginx still boots when the registry is down (the
# vhost just 502s until verdaccio is up) instead of failing to start.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic;
    listen [::]:443 quic;
    http2 on;
    http3 on;
    server_name ${SYNAPSE_REGISTRY_DOMAIN};

    ssl_certificate ${SYNAPSE_TLS_CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${SYNAPSE_TLS_CERT_DIR}/privkey.pem;
    ssl_trusted_certificate ${SYNAPSE_TLS_CERT_DIR}/chain.pem;
    ssl_session_cache shared:SynapseSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    quic_retry on;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    # Empty value (selfsigned mode) => nginx skips the header entirely. HSTS on
    # an untrusted cert would remove the browser's manual bypass, bricking the
    # deploy for its own users — render-edge-config.sh owns this policy.
    add_header Strict-Transport-Security "${SYNAPSE_HSTS_VALUE}" always;
    add_header Alt-Svc 'h3=":${SYNAPSE_TLS_PORT}"; ma=86400' always;

    # Sidecar tarballs are ~150-205MB; Verdaccio's own max_body_size is
    # 512mb. The default proxy cap would reject a publish, so raise it here.
    client_max_body_size 512m;

    # Trace trust boundary (Ring 0 -> 1): strip tracestate/baggage/sentry-trace,
    # KEEP traceparent — same posture as the web vhost; see
    # docs/trace-propagation-policy.md. The only proxied location below declares
    # its own proxy_set_header set, so the trio is re-declared there; these
    # server-level copies cover any future location that does not.
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header sentry-trace "";
    # Ring-0 ingress marker — nginx OWNS this header. proxy_set_header REPLACES
    # any client-supplied copy (single or repeated, probe-proven), so its
    # presence upstream means exactly "arrived through the public edge". The api
    # selects its span attribute synapse.trace.ingress=public from it. It grants
    # NOTHING: never an authn/authz/rate-limit-exemption input, never echoed.
    proxy_set_header x-synapse-trace-ingress "public";

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        set $verdaccio_upstream verdaccio;
        proxy_pass http://$verdaccio_upstream:4873;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
